# App Branding
VITE_APP_NAME=MergeBot
VITE_APP_VERSION=1.0.0

# API Configuration
# Backend API URL for Vite proxy
VITE_API_URL=http://localhost:8080

# WebSocket URL for real-time updates
VITE_WS_URL=ws://localhost:8080

# GitLab configuration (for MR/pipeline links)
VITE_GITLAB_URL=https://gitlab.com
VITE_GITLAB_PROJECT_PATH=mygroup/myproject
