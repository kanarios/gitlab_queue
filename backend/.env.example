# GitLab Merge Queue Bot - Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Must be set for the application to start
# =============================================================================

# GitLab personal access token with api scope
GITLAB_QUEUE_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# GitLab project ID (numeric ID from project settings, must be positive)
GITLAB_QUEUE_GITLAB_PROJECT_ID=12345678

# Secret key for JWT token signing
# IMPORTANT: Must be at least 64 characters (256 bits) for security
# Generate with: openssl rand -hex 64
GITLAB_QUEUE_JWT_SECRET=your-64-character-minimum-jwt-secret-key-generate-with-openssl-rand-hex-64

# GitLab webhook secret token for signature verification
# REQUIRED when webhooks are enabled (default: true)
# Generate with: openssl rand -hex 32
GITLAB_QUEUE_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# OPTIONAL - GitLab Connection
# =============================================================================

# GitLab instance URL (default: https://gitlab.com)
# GITLAB_QUEUE_GITLAB_URL=https://gitlab.com

# Target branch for merges (default: master)
# GITLAB_QUEUE_TARGET_BRANCH=master

# =============================================================================
# OPTIONAL - Queue Labels
# =============================================================================

# Label to add MR to merge queue (default: merge_queue)
# GITLAB_QUEUE_QUEUE_LABEL=merge_queue

# Label for priority/hotfix MRs (default: hotfix)
# GITLAB_QUEUE_HOTFIX_LABEL=hotfix

# =============================================================================
# OPTIONAL - Timing Configuration
# =============================================================================

# Polling interval in seconds for fallback polling (default: 30, must be positive)
# GITLAB_QUEUE_POLL_INTERVAL_SECONDS=30

# Maximum wait time for pipeline in seconds (default: 7200 = 2 hours, must be positive)
# GITLAB_QUEUE_PIPELINE_TIMEOUT_SECONDS=7200

# Maximum wait time for rebase operation in seconds (default: 300 = 5 minutes, must be positive)
# GITLAB_QUEUE_REBASE_TIMEOUT_SECONDS=300

# =============================================================================
# OPTIONAL - Retry Logic
# =============================================================================

# Number of times to retry failed pipelines (default: 1, cannot be negative)
# GITLAB_QUEUE_PIPELINE_RETRY_COUNT=1

# Maximum retries for GitLab API calls (default: 5, cannot be negative)
# GITLAB_QUEUE_API_MAX_RETRIES=5

# =============================================================================
# OPTIONAL - Database
# =============================================================================

# SQLite database URL (default: sqlite+aiosqlite:///data/queue.db)
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/dbname
# Note: Credentials in database URLs are masked in logs
# GITLAB_QUEUE_DATABASE_URL=sqlite+aiosqlite:///data/queue.db

# =============================================================================
# OPTIONAL - GitLab OAuth (for dashboard authentication)
# =============================================================================

# OAuth application ID from GitLab
# GITLAB_QUEUE_OAUTH_CLIENT_ID=your-oauth-app-id

# OAuth application secret from GitLab
# GITLAB_QUEUE_OAUTH_CLIENT_SECRET=your-oauth-app-secret

# OAuth callback URL (must match GitLab OAuth app settings)
# GITLAB_QUEUE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# JWT token expiration in hours (default: 24, must be positive)
# GITLAB_QUEUE_JWT_EXPIRATION_HOURS=24

# =============================================================================
# OPTIONAL - Webhook Server
# =============================================================================

# Enable webhook receiver (default: true)
# If enabled, GITLAB_QUEUE_WEBHOOK_SECRET is required
# GITLAB_QUEUE_WEBHOOK_ENABLED=true

# Webhook server host (default: 127.0.0.1)
# Use 0.0.0.0 only in containerized/production environments with proper firewall rules
# GITLAB_QUEUE_WEBHOOK_HOST=127.0.0.1

# Webhook server port (default: 8080, must be 1-65535)
# GITLAB_QUEUE_WEBHOOK_PORT=8080

# =============================================================================
# OPTIONAL - Dashboard
# =============================================================================

# Enable dashboard endpoints (default: true)
# GITLAB_QUEUE_DASHBOARD_ENABLED=true

# CORS allowed origins, comma-separated (default: http://localhost:5173 for Vite dev server)
# Wildcard (*) is not allowed for security reasons
# GITLAB_QUEUE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# OPTIONAL - Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# GITLAB_QUEUE_LOG_LEVEL=INFO

# Log format: json or console (default: json)
# GITLAB_QUEUE_LOG_FORMAT=json
