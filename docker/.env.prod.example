# =============================================================================
# GitLab Merge Queue Bot - Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.prod.example .env
#
# =============================================================================

# =============================================================================
# REQUIRED - GitLab Connection
# =============================================================================

# Choose one runtime configuration mode. During the first upgrade of an
# existing single-project database, keep only GITLAB_QUEUE_GITLAB_PROJECT_ID
# uncommented as a migration hint alongside GITLAB_QUEUE_PROJECTS.
#
# Multi-project mode (JSON must stay on one line). Each project has an
# independent token, target branch and queue labels:
GITLAB_QUEUE_PROJECTS=[{"project_id":12345678,"token":"glpat-project-one","target_branch":"main"},{"project_id":87654321,"token":"glpat-project-two","queue_label":"merge_queue","hotfix_label":"hotfix"}]

# Legacy single-project mode (comment out GITLAB_QUEUE_PROJECTS above):
# GITLAB_QUEUE_GITLAB_TOKEN=glpat-xxxxxxxxxxxx
# GITLAB_QUEUE_GITLAB_PROJECT_ID=12345678

# Multi-project upgrade hint (no legacy token is needed):
# GITLAB_QUEUE_GITLAB_PROJECT_ID=12345678

# =============================================================================
# REQUIRED - Security
# =============================================================================

# JWT signing secret (minimum 64 characters)
# Generate with: openssl rand -hex 64
GITLAB_QUEUE_JWT_SECRET=your-64-character-secret-key-here-generate-with-openssl-rand-hex-64

# Webhook signature secret (must match GitLab webhook configuration)
# Use the same value when configuring webhook in GitLab
GITLAB_QUEUE_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# OPTIONAL - GitLab Settings
# =============================================================================

# GitLab instance URL (default: https://gitlab.com)
# GITLAB_QUEUE_GITLAB_URL=https://gitlab.example.com

# Target branch for merges (default: master)
# GITLAB_QUEUE_TARGET_BRANCH=main

# Label that adds MR to queue (default: merge_queue)
# GITLAB_QUEUE_QUEUE_LABEL=merge_queue

# Label for priority/hotfix MRs (default: hotfix)
# GITLAB_QUEUE_HOTFIX_LABEL=hotfix

# =============================================================================
# OPTIONAL - OAuth (Dashboard Authentication)
# =============================================================================
# Without OAuth, the dashboard will be accessible without authentication.
# To enable authentication:
# 1. Create GitLab OAuth Application: User Settings → Applications
# 2. Set Redirect URI to: https://your-domain.com/auth/callback
# 3. Enable scopes: read_user, read_api
# 4. Fill in the values below

# GITLAB_QUEUE_OAUTH_CLIENT_ID=your-application-id
# GITLAB_QUEUE_OAUTH_CLIENT_SECRET=your-application-secret
# GITLAB_QUEUE_OAUTH_REDIRECT_URI=https://your-domain.com/auth/callback

# =============================================================================
# OPTIONAL - Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# GITLAB_QUEUE_LOG_LEVEL=INFO

# Log format: json, console (default: json)
# GITLAB_QUEUE_LOG_FORMAT=json

# =============================================================================
# OPTIONAL - Server Ports
# =============================================================================

# HTTP port (default: 80)
# PORT=80

# HTTPS port (default: 443)
# HTTPS_PORT=443
