# Multi-stage build for GitLab Queue Frontend
# Stage 1: Build with Node.js
# Stage 2: Serve with nginx
#
# Build from repo root:
#   docker build -f docker/Dockerfile.frontend -t gitlab-queue-frontend .

# =============================================================================
# Stage 1: Builder
# =============================================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files first for better layer caching
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY frontend/ .

# Build arguments for Vite environment variables
ARG VITE_API_URL=/api
ARG VITE_WS_URL=/ws
ARG VITE_GITLAB_URL=https://gitlab.com
ARG VITE_GITLAB_PROJECT_PATH=
ARG VITE_APP_NAME=MergeBot
ARG VITE_APP_VERSION=1.0.0

# Set environment variables for build
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WS_URL=${VITE_WS_URL}
ENV VITE_GITLAB_URL=${VITE_GITLAB_URL}
ENV VITE_GITLAB_PROJECT_PATH=${VITE_GITLAB_PROJECT_PATH}
ENV VITE_APP_NAME=${VITE_APP_NAME}
ENV VITE_APP_VERSION=${VITE_APP_VERSION}

# Build the application (skip tsc for production - Vite handles bundling)
RUN npx vite build

# =============================================================================
# Stage 2: Production Runtime
# =============================================================================
FROM nginx:1.27-alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx configuration and entrypoint from docker directory
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Create non-root user for security and set permissions
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup && \
    chown -R appuser:appgroup /usr/share/nginx/html && \
    chown -R appuser:appgroup /var/cache/nginx && \
    chown -R appuser:appgroup /etc/nginx && \
    # Create nginx temp directories for non-root user (matching nginx.conf paths)
    mkdir -p /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp && \
    chown -R appuser:appgroup /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp && \
    # Make entrypoint executable
    chmod +x /docker-entrypoint.sh

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

# Run as non-root user
USER appuser

# Use custom entrypoint to configure DNS resolver at runtime
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
